        <mxCell id="16" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Batch spool&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;/opt/netdb-harvester/spool/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontColor=#000000;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="975" y="375" width="370" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="17" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Warmup note&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;Weeks 1–3 are integration;&lt;br&gt;census not measurement-grade&lt;br&gt;until the router seasons.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#FEF7E0;strokeColor=#F9AB00;fontColor=#000000;spacingTop=14;" vertex="1" parent="1">
