        </mxCell>
        <mxCell id="15" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;netDb harvester (every 6 h)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;routerInfos + LeaseSets → JSONL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontColor=#000000;spacingTop=14;" vertex="1" parent="1">
