        <mxCell id="14" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px&quot;&gt;I2P floodfill router&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;Network: OK · i2np.floodfillParticipant&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#188038;fontColor=#000000;spacingTop=14;" vertex="1" parent="1">
