        <mxCell id="18" value="" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FEF7E0;strokeColor=#F9AB00;fontColor=#000000;strokeWidth=2;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="730" width="1340" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="19" value="&lt;b&gt;Disclosure notes (for the paper)&lt;/b&gt;&lt;br&gt;•  source_type = 'local_netdb' — client-sampled netDb view from the OCRI router (Tier 1); not a full DHT census.&lt;br&gt;•  source_type = 'vps_floodfill_netdb' — full-DHT view from the floodfill sensor (Tier 2); weeks 1–3 are warmup.&lt;br&gt;•  Every row epoch-tagged · 30-day epochs auto-roll with immutable CSV + SQL + SHA-256 exports.&lt;br&gt;•  VM1 → VM2 over internal TCP 3306 (least-privilege users) · VPS → VM2 by hourly rsync pull (inbound blocked)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="46" y="762" width="1308" height="112" as="geometry"/>
        </mxCell>
