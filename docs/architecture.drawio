        <mxCell id="11" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Batch ingest (every 30 min)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;JSONL → network_observations&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontColor=#000000;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="320" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Read-only dashboard&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;LAN / SSH tunnel · token auth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontColor=#000000;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="520" y="425" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px&quot;&gt;Per-epoch exports&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5F6368&quot;&gt;CSV + SQL dump + SHA-256 manifest&lt;br&gt;immutable, on rollover&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#9AA0A6;fontColor=#000000;spacingTop=14;" vertex="1" parent="1">
