# XL-I2P Study 2 — copy to .env and fill in. Every value has a sane default.
# VM1 (crawler) points DB_HOST at VM2's internal address.

# --- Database (MariaDB on VM2, reached over TCP) ---
DB_HOST=192.167.48.48
DB_PORT=3306
DB_USER=xl_i2p_crawler
DB_PASSWORD=CHANGE_ME
DB_NAME=xl_i2p_study2
# Full override (takes precedence over the parts above):
# DATABASE_URL=mysql+pymysql://xl_i2p_crawler:CHANGE_ME@192.167.48.48:3306/xl_i2p_study2?charset=utf8mb4

# --- I2P (router runs on VM1) ---
I2P_HTTP_PROXY=http://127.0.0.1:4444
CRAWLER_USER_AGENT=XL-I2P-Study2/2.0
KNOWN_TEST_EEPSITE=http://identiguy.i2p/
# Floodfill / netDB harvesting. Keep false unless the router has a public IP
# and the console shows Network: OK (requires OCRI admin network changes).
FLOODFILL_MODE=false

# --- Epoch ---
# Optional: pre-set the epoch label. Usually passed as --epoch-label instead.
EPOCH_LABEL=
# Automatic epoch rollover: the open epoch is closed (and exported by the
# rollover timer) and a new one opened once it reaches this age in days.
# This is what makes Study 2 longitudinal — keep it enabled.
EPOCH_DURATION_DAYS=30
EPOCH_AUTO_ROLLOVER=true

# --- I2P proxy startup ---
# Wait for the I2P HTTP proxy instead of exiting if it is down at startup.
PROXY_WAIT_ON_STARTUP=true
PROXY_RETRY_SECONDS=60

# --- Cross-layer Tier 1 (client-mode; works without a public IP) ---
# Bounded per-cycle association pass: SAM naming + LeaseSet lookup for
# REACHABLE/CRAWLED sites lacking this-epoch cross-layer observations.
XLINK_ENABLED=true
XLINK_PER_CYCLE_LIMIT=20
# Local netDb census: one NetworkObservation per router in the vantage
# router's own netDb store (client-sampled view, not the full DHT).
NETDB_CENSUS_ENABLED=true
NETDB_CENSUS_INTERVAL_SECONDS=86400

# --- Crawl loop (Study 1 validation defaults) ---
VERIFY_LIMIT=100
CRAWL_LIMIT=20
SLEEP_SECONDS=300
MAX_CONCURRENT_REQUESTS=5
MAX_CONCURRENT_SITES=2
REQUEST_TIMEOUT_SECONDS=60
MAX_PAGES_PER_SITE=25
MAX_DEPTH_PER_SITE=2
CRAWL_DELAY_SECONDS=2
MAX_CONTENT_BYTES=2000000

# --- Hardening ---
STALE_MINUTES=30
MAX_RETRIES=5
BACKOFF_BASE_SECONDS=60
BACKOFF_MAX_SECONDS=86400
HEARTBEAT_SECONDS=60
LOG_DIR=/opt/xl-i2p/logs
EXPORT_DIR=/opt/xl-i2p/exports

# --- Dashboard (read-only monitoring, runs on VM2) ---
# Token required as ?token=... or Authorization: Bearer ... on all routes
# except /healthz. Leave empty ONLY on a trusted internal network.
DASHBOARD_TOKEN=<long random token>
# 0.0.0.0 = range-LAN only (VM2 has no public IP). Use 127.0.0.1 + SSH
# port-forward for off-range access.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
