[Unit]
Description=Daily XL-I2P Study 2 epoch rollover check (VM2, DB-local export)

[Timer]
# Check daily; the rollover itself only fires when the epoch is due.
OnCalendar=daily
# If the VM was down at midnight, run on next boot instead of skipping.
Persistent=true
Unit=xl-i2p-epoch-rollover-vm2.service

[Install]
WantedBy=timers.target
