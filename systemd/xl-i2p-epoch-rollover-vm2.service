[Unit]
Description=XL-I2P Study 2 epoch rollover on VM2 (close due epoch, open next, export locally)
# Runs where the database lives: the export (CSVs + mysqldump + SHA-256
# manifest) is DB-local instead of crossing the VM1->VM2 network, and a
# quarterly full dump no longer competes with the crawler for VM1's
# disk/CPU. The crawler on VM1 keeps its in-loop rollover backstop
# (idempotent); it detects the new epoch on its next cycle.
# Replaces the VM1 xl-i2p-epoch-rollover.timer (disable that one).
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=xl-i2p
Group=xl-i2p
WorkingDirectory=/opt/xl-i2p/xl-i2p-study2-workaround
# Rollover needs a WRITE-capable DB user - not the dashboard's read-only
# user: SELECT + SHOW VIEW on all tables (export + mysqldump of the views),
# INSERT/UPDATE on epochs, and column UPDATE on sites (next_retry_at,
# failure_count, updated_at) for open_epoch's cohort reset. Exact GRANTs
# are in README.md "Epoch rollover".
# rollover.env: DATABASE_URL=mysql+pymysql://rollover:<pw>@192.167.48.48:3306/xl_i2p_study2?charset=utf8mb4
#               EXPORT_DIR=/opt/xl-i2p/exports
#               EPOCH_DURATION_DAYS=30   (must equal VM1's .env)
# NOTE: MariaDB on VM2 binds to 192.167.48.48 (no TCP on loopback), so the
# user must be 'rollover'@'192.167.48.48' - same pattern as the dashboard
# and ingest users. PyMySQL does not auto-use the Unix socket.
EnvironmentFile=/opt/xl-i2p/rollover.env
# Rollover: no-op unless the open epoch reached EPOCH_DURATION_DAYS.
# Export: every CLOSED epoch without a manifest under EXPORT_DIR, whoever
# rolled it (VM1's in-loop backstop usually rolls first). Exits non-zero
# if an export fails; the next daily run retries it.
ExecStart=/opt/xl-i2p/xl-i2p-study2-workaround/.venv/bin/python -m xl_i2p epoch rollover --export-closed
