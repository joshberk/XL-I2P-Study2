# VPS floodfill sensor — copy to .env and fill in.

# I2P router's netDb directory on this VPS (Java I2P default).
NETDB_DIR=/var/lib/i2p/i2p-config/netDb
# Local spool for JSONL batches (also holds harvest_cursor.json + shipped.json).
SPOOL_DIR=/opt/netdb-harvester/spool
# Stable sensor identity; recorded on every observation row.
SENSOR_ID=vps-floodfill-01

# --- ship.py: rsync to the VM2 ingest spool (key-based SSH) ---
VM2_HOST=192.167.48.48
VM2_USER=xl-i2p-ingest
VM2_SPOOL_DIR=/opt/xl-i2p/ingest_spool
# Optional: path to the SSH private key for the VM2 ingest user.
SSH_KEY=/home/i2p-harvest/.ssh/id_ed25519
# DRY_RUN=1 to log rsync commands without sending.
# DRY_RUN=0

# --- ingest/ingest_netdb.py runs on VM2 (separate .env there) ---
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=xl_i2p_ingest
# DB_PASSWORD=CHANGE_ME
# DB_NAME=xl_i2p_study2
# INGEST_SPOOL_DIR=/opt/xl-i2p/ingest_spool
